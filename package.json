{
  "name": "vi-dancer",
  "version": "0.18.1",
  "description": "Video Dancer — AI video-generation timeline editor",
  "author": "koan",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.koan.vidancer",
    "productName": "Video Dancer",
    "files": [
      "out/**",
      "package.json",
      "!out/renderer/fxlab.html",
      "!out/renderer/fxlab/**",
      "!out/renderer/assets/ort-wasm-*.wasm"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "koan-shdw",
        "repo": "video-dancer",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test-monitor-bindings.cjs && node scripts/test-project-safety.cjs && node scripts/test-recovery.cjs && node scripts/test-export.cjs && node scripts/test-watch.cjs && node scripts/test-watch-timeline.cjs && node scripts/test-voice.cjs && node scripts/test-editor-additions.cjs",
    "test:playback": "node scripts/test-monitor-browser.cjs",
    "test:dialogs": "node scripts/test-dialog-browser.cjs",
    "test:preload": "node scripts/test-preload-browser.cjs",
    "test:watch-ui": "node scripts/test-watch-browser.cjs",
    "test:voice-ui": "node scripts/test-voice-browser.cjs",
    "pin:shared": "node scripts/pin-shared.cjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "test:editor-ui": "node scripts/test-editor-additions-browser.cjs",
    "test:scrub": "node scripts/test-monitor-scrub.cjs",
    "test:transitions": "node scripts/test-transitions-browser.cjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.2.0",
    "@koan/shared": "file:../koan-shared",
    "@koan/vidancer-ui": "file:../koan-shared/vidancer-ui",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dockview": "^1.15.0",
    "electron": "44.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.18.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "zustand": "^5.0.0"
  }
}
