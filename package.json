{
  "name": "vi-dancer",
  "version": "0.21.1",
  "description": "Video Dancer — AI video-generation timeline editor",
  "author": "koan",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.koan.vidancer",
    "productName": "Video Dancer",
    "files": [
      "out/**",
      "package.json",
      "!out/renderer/fxlab.html",
      "!out/renderer/fxlab/**",
      "!out/renderer/assets/ort-wasm-*.wasm"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "koan-shdw",
        "repo": "video-dancer",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.video",
      "identity": null
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test-monitor-bindings.cjs && node scripts/test-project-safety.cjs && node scripts/test-save-lock.cjs && node scripts/test-disable-items.cjs &&node scripts/test-recovery.cjs && node scripts/test-export.cjs && node scripts/test-watch.cjs && node scripts/test-watch-timeline.cjs && node scripts/test-voice.cjs && node scripts/test-editor-additions.cjs && node scripts/test-score.cjs && node scripts/test-lane-overwrite.cjs && node scripts/test-nest.cjs && node scripts/test-speed.cjs && node scripts/test-reverse.cjs && node scripts/test-ark-image.cjs && node scripts/test-google-image.cjs && node scripts/test-engine-options.cjs && node scripts/test-omni11.cjs && node scripts/test-venice.cjs && node scripts/test-venice-bridge.cjs && node scripts/test-claude-wire.cjs && node scripts/test-ltx-full-only.cjs && node scripts/test-voice-direct.cjs && node scripts/test-mood-skill.cjs && node scripts/test-codir-models.cjs && node scripts/test-codir-effort.cjs && node scripts/test-codir-imagegen.cjs && node scripts/test-codir-rules.cjs && node scripts/test-codir-web.cjs && node scripts/test-codir-brief31.cjs && node scripts/test-bridge-login.cjs && node scripts/test-claude-login.cjs && node scripts/test-render-errors.cjs",
    "test:playback": "node scripts/test-monitor-browser.cjs",
    "test:dialogs": "node scripts/test-dialog-browser.cjs",
    "test:preload": "node scripts/test-preload-browser.cjs",
    "test:watch-ui": "node scripts/test-watch-browser.cjs",
    "test:voice-ui": "node scripts/test-voice-browser.cjs",
    "pin:shared": "node scripts/pin-shared.cjs",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "test:editor-ui": "node scripts/test-editor-additions-browser.cjs",
    "test:scrub": "node scripts/test-monitor-scrub.cjs",
    "test:transitions": "node scripts/test-transitions-browser.cjs",
    "test:codir-queue": "node scripts/test-codir-queue.cjs",
    "test:image-crop": "node scripts/test-image-crop-browser.cjs",
    "test:primary-images": "node scripts/test-primary-images.cjs",
    "test:score-ui": "node scripts/test-score-browser.cjs",
    "test:nest-ui": "node scripts/test-nest-browser.cjs",
    "test:timeline-keys": "node scripts/test-timeline-keys-browser.cjs",
    "test:speed-ui": "node scripts/test-speed-browser.cjs",
    "test:pen-ui": "node scripts/test-pen-browser.cjs",
    "test:export-many": "node scripts/test-export-many-browser.cjs",
    "test:tabs-ui": "node scripts/test-tabs-browser.cjs",
    "test:keepers-ui": "node scripts/test-keepers-browser.cjs",
    "test:folders-ui": "node scripts/test-folders-browser.cjs",
    "test:image-via-ui": "node scripts/test-image-via-browser.cjs",
    "test:vedit-omni11-ui": "node scripts/test-vedit-omni11-browser.cjs",
    "test:bridge-key-ui": "node scripts/test-bridge-key-row-browser.cjs",
    "test:codir-engine-ui": "node scripts/test-codir-engine-browser.cjs",
    "test:mood-fold-ui": "node scripts/test-mood-fold-browser.cjs",
    "test:codir-ran-ui": "node scripts/test-codir-ran-browser.cjs",
    "test:key-wizard-ui": "node scripts/test-key-wizard-browser.cjs",
    "test:queue-failure-ui": "node scripts/test-queue-failure-browser.cjs",
    "test:model-update": "node scripts/test-model-update.cjs",
    "test:take-colors": "node scripts/test-take-colors.cjs"
  },
  "dependencies": {
    "@fal-ai/client": "^1.2.0",
    "@koan/shared": "file:../koan-shared",
    "@koan/vidancer-ui": "file:../koan-shared/vidancer-ui",
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "dockview": "^1.15.0",
    "electron": "44.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "lucide-react": "^1.18.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0",
    "zustand": "^5.0.0"
  }
}
